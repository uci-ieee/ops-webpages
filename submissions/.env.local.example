# Copy to .env.local and fill in. .env.local is gitignored -- never commit real values.
# `neon env pull` writes the two DATABASE_* values for you once you are signed in.

# Neon pooled connection (hostname contains "-pooler"). Application query traffic.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# Neon direct connection (same host WITHOUT "-pooler"). Schema migrations only.
# drizzle-kit over PgBouncer's transaction pooling fails in ways that never
# mention pooling, so migrations must bypass the pooler.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full"

# Google OAuth client (Web application).
# Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Session signing secret. Generate one with:  npx auth secret
AUTH_SECRET=""

# Only @uci.edu accounts may sign in. Change only if the campus domain changes.
ALLOWED_EMAIL_DOMAIN="uci.edu"

# DEV ONLY. Set to 1 to enable the "sign in as" role switcher at /login so you
# can click through student/instructor/admin views without three Google accounts.
# Gated on NODE_ENV === "development", so it is compiled out of production
# builds entirely -- verified by /api/auth/providers listing only "google".
DEV_LOGIN="1"

# Shared secret for the scheduled retention sweep at /api/cron/purge.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# Canvas grade push. Leave blank to disable: grades are still recorded and
# queued, just not sent. The token must belong to an account with grading
# rights in the course (Canvas -> Account -> Settings -> New Access Token).
CANVAS_BASE_URL="https://canvas.eee.uci.edu"
CANVAS_TOKEN=""
CANVAS_COURSE_ID=""
